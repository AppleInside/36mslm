---
export const prerender = false;
import Management from '../../../layouts/Management.astro';
import { sql } from '../../../server/db';
import { getCollection } from 'astro:content';

const userDisplayName = Astro.locals.userDisplayName;

type SightingRow = {
  id: number;
  title: string;
  slug: string;
  category: string;
  date: string;
  status: 'draft' | 'published';
  coords: string | null;
};

const [dbSightings, collectionEntries] = await Promise.all([
  sql<SightingRow[]>`
    SELECT id, title, slug, category, date::text, coords::text, status
    FROM sightings
    WHERE lang = 'it'
    ORDER BY date DESC, id DESC
  `,
  getCollection('sightings'),
]);

const dbSlugs = new Set(dbSightings.map(s => s.slug).filter(Boolean));

const fileSightings = collectionEntries
  .filter(e => e.slug.startsWith('it/') && !dbSlugs.has(e.slug.replace('it/', '')))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map(e => ({
    slug:     e.slug.replace('it/', ''),
    title:    e.data.title,
    category: e.data.category,
    date:     e.data.date.toISOString().slice(0, 10),
    draft:    e.data.draft,
    coords:   e.data.coords as [number, number],
  }));

const totalCount = dbSightings.length + fileSightings.length;

type MapMarker = { title: string; category: string; lat: number; lng: number; id?: number; slug?: string };
const mapMarkers: MapMarker[] = [
  ...dbSightings
    .filter(s => s.coords)
    .map(s => {
      const [lat, lng] = JSON.parse(s.coords!) as [number, number];
      return { title: s.title, category: s.category, lat, lng, id: s.id };
    }),
  ...fileSightings.map(f => ({
    title: f.title, category: f.category, lat: f.coords[0], lng: f.coords[1], slug: f.slug,
  })),
];

const ok  = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');

const categoryLabel: Record<string, string> = {
  uccello: 'Uccello', mammifero: 'Mammifero', pesce: 'Pesce',
  rettile: 'Rettile', anfibio: 'Anfibio', pianta: 'Pianta', altro: 'Altro',
};

function fmtDate(d: string) {
  return new Date(d + 'T00:00:00').toLocaleDateString('it-IT', {
    day: '2-digit', month: 'short', year: 'numeric'
  });
}
---

<Management title="Fauna e Flora" userDisplayName={userDisplayName}>

  <div class="page">

    <div class="page-header">
      <div>
        <h1 class="page-title">Fauna e Flora</h1>
        <p class="page-count">
          {totalCount === 0 ? 'Nessun avvistamento' : `${totalCount} ${totalCount === 1 ? 'avvistamento' : 'avvistamenti'}`}
        </p>
      </div>
      <a href="/management/fauna/nuovo" class="btn-primary">
        <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
          <path d="M5.5 1V10M1 5.5H10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        Nuovo avvistamento
      </a>
    </div>

    {ok && (
      <div class="flash flash--ok" role="status">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="6.5" stroke="currentColor"/>
          <path d="M4.5 7L6.5 9L9.5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Operazione completata con successo.
      </div>
    )}
    {err && (
      <div class="flash flash--err" role="alert">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="6.5" stroke="currentColor"/>
          <line x1="7" y1="4" x2="7" y2="7.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          <circle cx="7" cy="9.5" r="0.75" fill="currentColor"/>
        </svg>
        Si è verificato un errore. Riprova.
      </div>
    )}

    {fileSightings.length > 0 && (
      <div class="import-banner">
        <div class="import-banner-text">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="7" cy="7" r="6.5" stroke="currentColor"/>
            <line x1="7" y1="3.5" x2="7" y2="7.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            <circle cx="7" cy="9.8" r="0.75" fill="currentColor"/>
          </svg>
          <span>{fileSightings.length} {fileSightings.length === 1 ? 'voce viene' : 'voci vengono'} dai file di contenuto e non {fileSightings.length === 1 ? 'è modificabile' : 'sono modificabili'}.</span>
        </div>
        <form method="POST" action="/api/management/fauna/importa">
          <button type="submit" class="import-btn">Importa nel database</button>
        </form>
      </div>
    )}

    {mapMarkers.length > 0 && (
      <div class="map-section">
        <div id="mgmt-map" class="mgmt-map"></div>
      </div>
    )}

    {totalCount === 0 && (
      <div class="empty">
        <svg class="empty-icon" width="52" height="52" viewBox="0 0 52 52" fill="none" aria-hidden="true">
          <path d="M26 8C26 8 18 16 18 24C18 30 22 33 26 33C30 33 34 30 34 24C34 16 26 8 26 8Z" stroke="currentColor" stroke-width="1.4"/>
          <path d="M26 33V44" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          <path d="M20 42H32" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        <p class="empty-title">Nessun avvistamento ancora</p>
        <p class="empty-sub">Documenta specie animali e vegetali del territorio.</p>
        <a href="/management/fauna/nuovo" class="btn-primary">Aggiungi avvistamento</a>
      </div>
    )}

    {totalCount > 0 && (
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Specie</th>
              <th class="hide-sm">Categoria</th>
              <th class="hide-md">Data</th>
              <th>Stato</th>
              <th class="th-actions">Azioni</th>
            </tr>
          </thead>
          <tbody>
            {dbSightings.map((s, i) => (
              <tr style={`--i:${i}`}>
                <td><span class="ev-title">{s.title}</span></td>
                <td class="hide-sm">
                  <span class="badge badge--dim">{categoryLabel[s.category] ?? s.category}</span>
                </td>
                <td class="hide-md">
                  <span class="ev-meta">{fmtDate(s.date)}</span>
                </td>
                <td>
                  {s.status === 'published'
                    ? <span class="badge badge--teal">Pubblicato</span>
                    : <span class="badge badge--dim">Bozza</span>
                  }
                </td>
                <td>
                  <div class="row-actions">
                    <a href={`/management/fauna/${s.id}`} class="act-edit" title="Modifica">
                      <svg width="18" height="18" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="M9.5 2.5L11.5 4.5L5 11H3V9L9.5 2.5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                        <path d="M8 4L10 6" stroke="currentColor" stroke-width="1.2"/>
                      </svg>
                    </a>
                    <form
                      method="POST"
                      action={`/api/management/fauna/${s.id}/delete`}
                      class="delete-form"
                      data-title={s.title}
                    >
                      <button type="button" class="act-delete" title="Elimina" data-delete-trigger>
                        <svg width="18" height="18" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                          <path d="M2 4H12M5 4V2.5C5 2.22 5.22 2 5.5 2H8.5C8.78 2 9 2.22 9 2.5V4M5.5 6.5V10.5M8.5 6.5V10.5M3 4L3.6 11.5C3.63 11.8 3.88 12 4.18 12H9.82C10.12 12 10.37 11.8 10.4 11.5L11 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
            {fileSightings.map((f, i) => (
              <tr style={`--i:${dbSightings.length + i}`} class="row-file">
                <td>
                  <a href={`/it/scopri/fauna#${f.slug}`} class="ev-title ev-title--link" target="_blank" rel="noopener">
                    {f.title}
                  </a>
                </td>
                <td class="hide-sm">
                  <span class="badge badge--dim">{categoryLabel[f.category] ?? f.category}</span>
                </td>
                <td class="hide-md">
                  <span class="ev-meta">{fmtDate(f.date)}</span>
                </td>
                <td>
                  {f.draft
                    ? <span class="badge badge--dim">Bozza</span>
                    : <span class="badge badge--teal">Pubblicato</span>
                  }
                </td>
                <td>
                  <span class="file-pill" title="Contenuto da file — modifica il file .mdx">file</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

  </div>

  <div id="delete-modal" class="modal-backdrop" aria-hidden="true">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <div class="modal-icon">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path d="M3 7H19M8 7V5C8 4.45 8.45 4 9 4H13C13.55 4 14 4.45 14 5V7M9 11V16M13 11V16M4.5 7L5.4 18C5.45 18.56 5.92 19 6.5 19H15.5C16.08 19 16.55 18.56 16.6 18L17.5 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="modal-body">
        <h2 class="modal-title" id="modal-title">Elimina avvistamento</h2>
        <p class="modal-text">
          Stai per eliminare <strong id="modal-item-name"></strong>. L'operazione non può essere annullata.
        </p>
      </div>
      <div class="modal-actions">
        <button type="button" class="modal-cancel" id="modal-cancel">Annulla</button>
        <button type="button" class="modal-confirm" id="modal-confirm">Elimina</button>
      </div>
    </div>
  </div>

</Management>

<script>
  let pendingForm: HTMLFormElement | null = null;
  const modal      = document.getElementById('delete-modal')!;
  const nameEl     = document.getElementById('modal-item-name')!;
  const cancelBtn  = document.getElementById('modal-cancel')!;
  const confirmBtn = document.getElementById('modal-confirm')!;

  function openModal(form: HTMLFormElement) {
    pendingForm = form;
    nameEl.textContent = form.dataset.title ?? 'questo avvistamento';
    modal.setAttribute('aria-hidden', 'false');
    modal.classList.add('is-open');
    cancelBtn.focus();
  }
  function closeModal() {
    pendingForm = null;
    modal.setAttribute('aria-hidden', 'true');
    modal.classList.remove('is-open');
  }

  document.querySelectorAll<HTMLButtonElement>('[data-delete-trigger]').forEach(btn => {
    btn.addEventListener('click', () => {
      const form = btn.closest<HTMLFormElement>('.delete-form');
      if (form) openModal(form);
    });
  });
  cancelBtn.addEventListener('click', closeModal);
  confirmBtn.addEventListener('click', () => { pendingForm?.submit(); closeModal(); });
  modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal(); });

  document.querySelectorAll<HTMLElement>('.flash').forEach(el => {
    setTimeout(() => {
      el.style.transition = 'opacity 0.5s, transform 0.5s';
      el.style.opacity = '0';
      el.style.transform = 'translateY(-4px)';
      setTimeout(() => el.remove(), 500);
    }, 4000);
  });
</script>

<script id="map-data" type="application/json" is:inline set:html={JSON.stringify(mapMarkers)}></script>
<script is:inline>
  (function () {
    const el = document.getElementById('mgmt-map');
    if (!el) return;

    const markers = JSON.parse(document.getElementById('map-data').textContent || '[]');

    const cssLink = document.createElement('link');
    cssLink.rel = 'stylesheet';
    cssLink.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
    document.head.appendChild(cssLink);

    const jsScript = document.createElement('script');
    jsScript.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    jsScript.onload = function () {
      const catColor = {
        uccello:'#3a7abf', mammifero:'#9b6020', pesce:'#1f8a9a',
        rettile:'#5a8a1e', anfibio:'#2e7a3e', pianta:'#2d6a4f', altro:'#6b7280',
      };
      const catLabel = {
        uccello:'Uccello', mammifero:'Mammifero', pesce:'Pesce',
        rettile:'Rettile', anfibio:'Anfibio', pianta:'Pianta', altro:'Altro',
      };

      var map = L.map(el, { scrollWheelZoom: false, zoomControl: true, attributionControl: false });
      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', { maxZoom: 19 }).addTo(map);

      if (markers.length === 0) {
        map.setView([44.96, 10.10], 13);
        return;
      }

      var group = L.featureGroup();
      markers.forEach(function (m) {
        var color = catColor[m.category] || '#6b7280';
        var label = catLabel[m.category] || m.category;
        var action = m.id
          ? '<a href="/management/fauna/' + m.id + '" style="color:#D8A14A;font-size:0.68rem;text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;font-family:\'IBM Plex Mono\',monospace">Modifica →</a>'
          : '<span style="color:rgba(232,220,200,0.3);font-size:0.68rem;font-family:\'IBM Plex Mono\',monospace;letter-spacing:0.08em">da file</span>';
        var popup = '<div style="font-family:\'IBM Plex Mono\',monospace;padding:10px 13px;min-width:140px;background:#111f1e;border-radius:5px">'
          + '<strong style="font-size:0.88rem;color:#E8DCC8;font-weight:400">' + m.title + '</strong>'
          + '<div style="font-size:0.7rem;color:rgba(232,220,200,0.4);margin-top:3px;letter-spacing:0.08em;text-transform:uppercase">' + label + '</div>'
          + '<div style="margin-top:8px">' + action + '</div>'
          + '</div>';
        var marker = L.circleMarker([m.lat, m.lng], {
          radius: 8, fillColor: color, color: 'rgba(255,255,255,0.5)',
          weight: 1.5, opacity: 1, fillOpacity: 0.88,
        });
        marker.bindPopup(popup, { className: 'mgmt-popup' });
        group.addLayer(marker);
        map.addLayer(marker);
      });

      map.fitBounds(group.getBounds().pad(0.35));
    };
    document.head.appendChild(jsScript);
  })();
</script>

<style>
  .page { display: flex; flex-direction: column; gap: 1.5rem; animation: page-in 0.45s cubic-bezier(0.22,1,0.36,1) both; }
  @keyframes page-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .page-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(232,220,200,0.06); }
  .page-title { font-family: 'Fraunces', Georgia, serif; font-size: 2.1rem; font-weight: 300; color: #E8DCC8; line-height: 1; letter-spacing: -0.01em; }
  .page-count { margin-top: 0.4rem; font-family: 'IBM Plex Mono', monospace; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(232,220,200,0.3); }
  .btn-primary { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.65rem 1.25rem; background: #D8A14A; color: #1A0E00; font-family: 'IBM Plex Mono', monospace; font-size: 0.78rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; border: none; border-radius: 3px; cursor: pointer; white-space: nowrap; transition: background 0.2s, transform 0.15s; }
  .btn-primary:hover { background: #E8B05A; transform: translateY(-1px); }
  .import-banner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.75rem 1rem; border-radius: 4px; background: rgba(216,161,74,0.07); border: 1px solid rgba(216,161,74,0.2); }
  .import-banner-text { display: flex; align-items: center; gap: 0.55rem; font-family: 'IBM Plex Mono', monospace; font-size: 0.82rem; letter-spacing: 0.02em; color: rgba(216,161,74,0.75); }
  .import-btn { padding: 0.45rem 1rem; background: rgba(216,161,74,0.15); border: 1px solid rgba(216,161,74,0.35); border-radius: 3px; font-family: 'IBM Plex Mono', monospace; font-size: 0.72rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: #D8A14A; cursor: pointer; white-space: nowrap; transition: background 0.15s, border-color 0.15s; }
  .import-btn:hover { background: rgba(216,161,74,0.25); border-color: rgba(216,161,74,0.55); }
  .map-section { border: 1px solid rgba(232,220,200,0.07); border-radius: 6px; overflow: hidden; }
  .mgmt-map { width: 100%; height: 360px; background: #0d1c1b; }
  :global(.mgmt-popup .leaflet-popup-content-wrapper) { background: #111f1e !important; border: 1px solid rgba(232,220,200,0.12) !important; border-radius: 5px !important; box-shadow: 0 8px 28px rgba(0,0,0,0.5) !important; padding: 0 !important; }
  :global(.mgmt-popup .leaflet-popup-content) { margin: 0 !important; }
  :global(.mgmt-popup .leaflet-popup-tip) { background: #111f1e !important; }
  .flash { display: flex; align-items: center; gap: 0.55rem; padding: 0.75rem 1rem; border-radius: 4px; border: 1px solid; font-family: 'IBM Plex Mono', monospace; font-size: 0.85rem; letter-spacing: 0.03em; }
  .flash--ok  { color: #7BC4B4; background: rgba(74,102,112,0.1); border-color: rgba(74,102,112,0.28); }
  .flash--err { color: #E07B5A; background: rgba(224,123,90,0.07); border-color: rgba(224,123,90,0.22); }
  .empty { display: flex; flex-direction: column; align-items: center; gap: 0.8rem; padding: 4rem 2rem; text-align: center; }
  .empty-icon { color: rgba(232,220,200,0.15); margin-bottom: 0.5rem; }
  .empty-title { font-family: 'Fraunces', Georgia, serif; font-size: 1.35rem; font-weight: 300; color: rgba(232,220,200,0.5); }
  .empty-sub { font-family: 'IBM Plex Mono', monospace; font-size: 0.82rem; letter-spacing: 0.04em; color: rgba(232,220,200,0.28); max-width: 320px; line-height: 1.65; margin-bottom: 0.5rem; }
  .table-wrap { border: 1px solid rgba(232,220,200,0.07); border-radius: 6px; overflow: hidden; background: rgba(232,220,200,0.015); }
  .table { width: 100%; border-collapse: collapse; font-family: 'IBM Plex Mono', monospace; }
  .table thead tr { background: rgba(232,220,200,0.04); border-bottom: 1px solid rgba(232,220,200,0.07); }
  .table th { padding: 0.75rem 1rem; text-align: left; font-size: 0.68rem; font-weight: 400; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(232,220,200,0.3); white-space: nowrap; border-right: 1px solid rgba(232,220,200,0.06); }
  .table th:last-child { border-right: none; }
  .th-actions { text-align: right; }
  .table tbody tr { border-bottom: 1px solid rgba(232,220,200,0.04); transition: background 0.18s; animation: row-in 0.4s cubic-bezier(0.22,1,0.36,1) both; animation-delay: calc(var(--i, 0) * 40ms + 80ms); }
  @keyframes row-in { from { opacity: 0; transform: translateX(-6px); } to { opacity: 1; transform: translateX(0); } }
  .table tbody tr:last-child { border-bottom: none; }
  .table tbody tr:hover { background: rgba(74,102,112,0.10); }
  .table td { padding: 0.9rem 1rem; vertical-align: middle; border-right: 1px solid rgba(232,220,200,0.04); }
  .table td:last-child { border-right: none; }
  .ev-title { font-family: 'Fraunces', Georgia, serif; font-size: 1.05rem; font-weight: 300; color: #E8DCC8; letter-spacing: 0.01em; }
  .ev-meta { font-size: 0.82rem; color: rgba(232,220,200,0.4); letter-spacing: 0.02em; white-space: nowrap; }
  .badge { display: inline-flex; align-items: center; padding: 0.25rem 0.65rem; border-radius: 20px; font-size: 0.68rem; font-weight: 400; letter-spacing: 0.12em; text-transform: uppercase; border: 1px solid; white-space: nowrap; }
  .badge--teal { background: rgba(74,102,112,0.18); color: #7BC4B4; border-color: rgba(74,102,112,0.32); }
  .badge--dim  { background: rgba(232,220,200,0.04); color: rgba(232,220,200,0.38); border-color: rgba(232,220,200,0.10); }
  .row-actions { display: flex; align-items: center; justify-content: flex-end; gap: 0.4rem; }
  .act-edit, .act-delete { display: flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 5px; border: 1px solid transparent; background: none; cursor: pointer; font-family: inherit; padding: 0; transition: background 0.18s, border-color 0.18s, color 0.18s; }
  .act-edit { color: rgba(216,161,74,0.55); text-decoration: none; }
  .act-edit:hover { color: #D8A14A; background: rgba(216,161,74,0.10); border-color: rgba(216,161,74,0.22); }
  .act-delete { color: rgba(224,123,90,0.45); }
  .act-delete:hover { color: #E07B5A; background: rgba(224,123,90,0.10); border-color: rgba(224,123,90,0.22); }
  .ev-title--link { text-decoration: none; color: inherit; transition: color 0.15s; }
  .ev-title--link:hover { color: #D8A14A; }
  .row-file { opacity: 0.82; }
  .file-pill { display: inline-flex; align-items: center; padding: 0.2rem 0.5rem; border-radius: 3px; font-size: 0.62rem; font-weight: 400; letter-spacing: 0.18em; text-transform: uppercase; background: rgba(232,220,200,0.04); color: rgba(232,220,200,0.25); border: 1px solid rgba(232,220,200,0.08); white-space: nowrap; }
  @media (max-width: 900px) { .hide-md { display: none; } }
  @media (max-width: 600px) { .hide-sm { display: none; } .page-title { font-size: 1.6rem; } }
